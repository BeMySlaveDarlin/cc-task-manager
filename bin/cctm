#!/usr/bin/env python3
from __future__ import annotations

import argparse
import contextlib
import io
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from datetime import date
from pathlib import Path

SCHEMA_VERSION = 2
PRIORITIES = ("HIGH", "MEDIUM", "LOW")
STATUSES = ("open", "deferred", "done", "cancelled")
TERMINAL = ("done", "cancelled")
PRIORITY_RANK = {"HIGH": 0, "MEDIUM": 1, "LOW": 2}
ACTIVE = ("open", "deferred")

HANDOFF_VERSION = 1
HANDOFF_KEEP = 20
HANDOFF_MAX_CHARS = 20000
HANDOFF_ATTACH_MAX_MB = 20
HANDOFF_FRESH_HOURS = 48
HANDOFF_KEEP_PER_PLACE = 3
TOUCHED_KEEP = 20
LIVE_MINUTES = 30
SESSION_START_OTHERS = 5

SESSION_START_MODES = ("off", "brief", "full")
SESSION_START_SOURCES = ("startup", "clear")
SESSION_START_NEXT = 3
SESSION_START_STEP_LINES = 8
SESSION_START_STEP_CHARS = 700

TEXT_FIELDS = ("description", "context", "precondition", "verify", "result")
LIST_FIELDS = ("plan", "files")

SECTION_MAP = {
    "описание": "description",
    "проблема": "description",
    "description": "description",
    "problem": "description",
    "контекст": "context",
    "context": "context",
    "план": "plan",
    "plan": "plan",
    "предусловие": "precondition",
    "prerequisite": "precondition",
    "как проверить": "verify",
    "проверка": "verify",
    "verify": "verify",
    "что сделано": "result",
    "результат": "result",
    "result": "result",
    "ключевые файлы": "files",
    "файлы": "files",
    "files": "files",
}

SECTION_TITLES = (
    ("description", "Описание"),
    ("context", "Контекст"),
    ("plan", "План"),
    ("precondition", "Предусловие"),
    ("verify", "Как проверить"),
    ("result", "Что сделано"),
    ("files", "Ключевые файлы"),
)


class CctmError(Exception):
    pass


def today() -> str:
    return date.today().isoformat()


def empty_body() -> dict:
    body = {f: "" for f in TEXT_FIELDS}
    body.update({f: [] for f in LIST_FIELDS})
    body["notes"] = {}
    return body


def is_within(path: Path, root: Path) -> bool:
    return path == root or root in path.parents


def git_toplevel(start: Path) -> Path | None:
    for d in [start, *start.parents]:
        if (d / ".git").exists():
            return d
    return None


def git_dir(top: Path) -> Path | None:
    marker = top / ".git"
    if marker.is_dir():
        return marker
    try:
        text = marker.read_text(encoding="utf-8").strip()
    except OSError:
        return None
    if not text.startswith("gitdir:"):
        return None
    path = Path(text[len("gitdir:") :].strip())
    return path if path.is_absolute() else (top / path).resolve()


def main_checkout(top: Path) -> Path:
    gitdir = git_dir(top)
    if gitdir is None or gitdir == top / ".git":
        return top
    try:
        common = (gitdir / (gitdir / "commondir").read_text(encoding="utf-8").strip()).resolve()
    except OSError:
        return top
    return common.parent if common.name == ".git" else top


def worktree_paths(main: Path) -> list[Path]:
    paths = [main]
    registry = main / ".git" / "worktrees"
    if not registry.is_dir():
        return paths
    for entry in sorted(registry.iterdir()):
        with contextlib.suppress(OSError):
            path = Path((entry / "gitdir").read_text(encoding="utf-8").strip()).parent.resolve()
            if path not in paths:
                paths.append(path)
    return paths


def head_branch(top: Path | None) -> str:
    gitdir = git_dir(top) if top is not None else None
    if gitdir is None:
        return ""
    try:
        head = (gitdir / "HEAD").read_text(encoding="utf-8").strip()
    except OSError:
        return ""
    prefix = "ref: refs/heads/"
    return head[len(prefix) :] if head.startswith(prefix) else ""


def locate_store(cwd: str | None = None, strict: bool = False) -> tuple[Path | None, Path]:
    cur = Path(cwd or os.getcwd()).resolve()
    top = git_toplevel(cur)
    stop = top
    if top is None:
        anchor = session_anchor()
        if anchor is not None and is_within(cur, anchor):
            stop = anchor
    chain = [cur]
    if stop is not None or not strict:
        home = Path.home().resolve()
        chain = []
        for d in [cur, *cur.parents]:
            if stop is None and d == home and cur != home:
                break
            chain.append(d)
            if d == stop:
                break
    for d in chain:
        if (d / ".claude" / "session").is_dir():
            return d / ".claude" / "session", d / ".claude" / "session"
    if top is None:
        default = (stop or cur) / ".claude" / "session"
        return None, default
    main = main_checkout(top)
    default = main / ".claude" / "session"
    if default.is_dir():
        return default, default
    anchor = session_anchor()
    if anchor is not None and anchor != top and is_within(cur, anchor) and (anchor / ".claude" / "session").is_dir():
        return anchor / ".claude" / "session", anchor / ".claude" / "session"
    return None, default


def hook_root(cwd: str | None = None) -> Path | None:
    return locate_store(cwd, strict=True)[0]


def find_root(start: str | None = None) -> Path:
    found, default = locate_store(start)
    return found or default


class Store:
    def __init__(self, root: Path):
        self.root = Path(root)
        self._places: list[Path] | None = None

    @property
    def tasks_dir(self) -> Path:
        return self.root / "tasks"

    @property
    def handoff_dir(self) -> Path:
        return self.root / "handoff"

    @property
    def meta_path(self) -> Path:
        return self.root / "meta.json"

    @property
    def lock_path(self) -> Path:
        return self.root / ".lock"

    def exists(self) -> bool:
        return self.meta_path.is_file() or self.tasks_dir.is_dir()

    def legacy_count(self) -> int:
        details = self.root / "details"
        files = len(list(details.rglob("*.md"))) if details.is_dir() else 0
        return files + (1 if (self.root / "tasks.md").is_file() else 0)

    def init(self) -> None:
        self.tasks_dir.mkdir(parents=True, exist_ok=True)
        if not self.meta_path.is_file():
            write_json(self.meta_path, {"version": SCHEMA_VERSION, "next_id": 1, "updated": today()})

    def meta(self) -> dict:
        if not self.meta_path.is_file():
            return {"version": SCHEMA_VERSION, "next_id": 1, "updated": today()}
        return read_json(self.meta_path)

    def save_meta(self, meta: dict) -> None:
        meta["updated"] = today()
        write_json(self.meta_path, meta)

    def path_of(self, tid: int) -> Path:
        return self.tasks_dir / f"{tid:03d}.json"

    def read(self, tid: int) -> dict | None:
        path = self.path_of(tid)
        if not path.is_file():
            for candidate in self.tasks_dir.glob("*.json"):
                if candidate.stem.lstrip("0") == str(tid):
                    return read_json(candidate)
            return None
        return read_json(path)

    def write(self, task: dict, touch: bool = True, by: str | None = None) -> None:
        self.tasks_dir.mkdir(parents=True, exist_ok=True)
        task["updated"] = today()
        if touch:
            key = by or session_key(session_uuid())
            if key != "unknown":
                task["session"] = key
                touched = [k for k in task.get("touched_by") or [] if k != key]
                task["touched_by"] = (touched + [key])[-TOUCHED_KEEP:]
        write_json(self.path_of(task["id"]), task)

    def remove(self, tid: int) -> None:
        self.path_of(tid).unlink(missing_ok=True)

    def all(self) -> list[dict]:
        if not self.tasks_dir.is_dir():
            return []
        tasks = []
        for path in sorted(self.tasks_dir.glob("*.json")):
            try:
                tasks.append(read_json(path))
            except json.JSONDecodeError as exc:
                raise CctmError(f"битый файл {path}: {exc}") from exc
        return sorted(tasks, key=lambda t: t.get("id", 0))

    def take_id(self) -> int:
        meta = self.meta()
        tid = int(meta.get("next_id", 1))
        used = {t.get("id") for t in self.all()}
        while tid in used:
            tid += 1
        meta["next_id"] = tid + 1
        self.save_meta(meta)
        return tid


def read_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


@contextlib.contextmanager
def locked(store: Store):
    try:
        import fcntl
    except ImportError:
        yield
        return
    store.root.mkdir(parents=True, exist_ok=True)
    with open(store.lock_path, "w", encoding="utf-8") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def parse_md(text: str) -> dict:
    body = empty_body()
    current = None
    buf: list[str] = []

    def flush():
        if current is None:
            return
        chunk = "\n".join(buf).strip()
        field = SECTION_MAP.get(current.strip().lower())
        if field in LIST_FIELDS:
            body[field] = extract_items(chunk)
        elif field:
            body[field] = chunk
        elif chunk:
            body["notes"][current.strip()] = chunk

    for line in text.splitlines():
        heading = re.match(r"^#{2,}\s+(.+?)\s*$", line)
        if heading:
            flush()
            current = heading.group(1)
            buf = []
            continue
        if re.match(r"^#\s+", line) and current is None:
            continue
        buf.append(line)
    flush()
    return body


def extract_items(chunk: str) -> list[str]:
    items = []
    for line in chunk.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        bullet = re.match(r"^(?:[-*+]|\d+[.)])\s+(.*)$", stripped)
        if bullet:
            items.append(bullet.group(1).strip())
        elif items:
            items[-1] += " " + stripped
        else:
            items.append(stripped)
    return items


def render_md(task: dict, with_title: bool = True) -> str:
    body = task.get("body") or {}
    parts = []
    if with_title:
        parts.append(f"# {task.get('title', '')}\n")
    for field, heading in SECTION_TITLES:
        value = body.get(field)
        if not value:
            continue
        parts.append(f"## {heading}")
        if field in LIST_FIELDS:
            parts.extend(f"- {item}" for item in value)
        else:
            parts.append(str(value))
        parts.append("")
    for heading, value in (body.get("notes") or {}).items():
        parts.append(f"## {heading}")
        parts.append(str(value))
        parts.append("")
    return "\n".join(parts).rstrip() + "\n"


def merge_body(current: dict, incoming: dict, replace: bool = False) -> dict:
    if replace:
        merged = empty_body()
    else:
        merged = empty_body()
        merged.update(current or {})
    for field in TEXT_FIELDS:
        if incoming.get(field):
            merged[field] = incoming[field]
    for field in LIST_FIELDS:
        if incoming.get(field):
            merged[field] = incoming[field]
    notes = dict(merged.get("notes") or {})
    notes.update(incoming.get("notes") or {})
    merged["notes"] = notes
    return merged


def read_source(value: str) -> str:
    if value == "-":
        return sys.stdin.read()
    path = Path(value)
    if not path.is_file():
        raise CctmError(f"файл не найден: {value}")
    return path.read_text(encoding="utf-8")


def parse_ids(value: str | None) -> list[int]:
    if not value:
        return []
    ids = []
    for chunk in re.split(r"[,\s]+", value.strip()):
        if not chunk:
            continue
        if not chunk.lstrip("#").isdigit():
            raise CctmError(f"не число: {chunk}")
        ids.append(int(chunk.lstrip("#")))
    return ids


def parse_tags(value: str | None) -> list[str]:
    if not value:
        return []
    return [t.strip() for t in value.split(",") if t.strip()]


def sort_key(task: dict):
    order = task.get("order")
    return (
        PRIORITY_RANK.get(task.get("priority", "MEDIUM"), 1),
        order if isinstance(order, int) else 10**6,
        task.get("id", 0),
    )


def require(store: Store, tid: int) -> dict:
    task = store.read(tid)
    if task is None:
        raise CctmError(f"задача #{tid} не найдена")
    return task


def blockers_of(task: dict, by_id: dict[int, dict]) -> list[int]:
    return [b for b in task.get("blockedBy") or [] if by_id.get(b, {}).get("status") != "done"]


def branch_key(branch: str):
    if not branch:
        return sort_key
    return lambda task: (task.get("branch") != branch, *sort_key(task))


def split_next(store: Store, branch: str = "") -> tuple[list[dict], list[dict], dict[int, dict]]:
    tasks = store.all()
    by_id = {t["id"]: t for t in tasks}
    ready = [t for t in tasks if t.get("status") == "open" and not blockers_of(t, by_id)]
    blocked = [t for t in tasks if t.get("status") == "open" and blockers_of(t, by_id)]
    key = branch_key(branch)
    return sorted(ready, key=key), sorted(blocked, key=key), by_id


def format_row(task: dict, by_id: dict[int, dict], live: dict[str, str] | None = None) -> str:
    tags = ",".join(task.get("tags") or [])
    blocked = blockers_of(task, by_id)
    title = task.get("title", "")
    if len(title) > 58:
        title = title[:57] + "…"
    row = f"#{task['id']:<4} {task.get('priority', 'MEDIUM'):<7} {task.get('status', 'open'):<9} {title:<58}"
    if tags:
        row += f"  [{tags}]"
    if blocked:
        row += "  блокер: " + ", ".join(f"#{b}" for b in blocked)
    if live and task.get("session") in live:
        row += f"  ⚑ {live[task['session']]}"
    return row.rstrip()


def print_tasks(tasks: list[dict], by_id: dict[int, dict], empty: str, live: dict[str, str] | None = None) -> None:
    if not tasks:
        print(empty)
        return
    for task in tasks:
        print(format_row(task, by_id, live))


def cmd_init(args, store: Store) -> int:
    with locked(store):
        store.init()
    print(f"стор готов: {store.root}")
    return 0


def cmd_create(args, store: Store) -> int:
    if args.priority and args.priority not in PRIORITIES:
        raise CctmError(f"приоритет: {', '.join(PRIORITIES)}")
    if args.status not in STATUSES:
        raise CctmError(f"статус: {', '.join(STATUSES)}")
    body = empty_body()
    if args.md:
        body = merge_body(body, parse_md(read_source(args.md)))
    with locked(store):
        store.init()
        known = {t["id"] for t in store.all()}
        blocked = parse_ids(args.blocked_by)
        missing = [b for b in blocked if b not in known]
        if missing:
            raise CctmError("нет таких задач: " + ", ".join(f"#{m}" for m in missing))
        tid = store.take_id()
        task = {
            "id": tid,
            "title": args.title.strip(),
            "status": args.status,
            "priority": args.priority or "MEDIUM",
            "order": args.order,
            "created": today(),
            "updated": today(),
            "closed": None,
            "created_by": session_key(session_uuid()),
            "blockedBy": blocked,
            "tags": parse_tags(args.tags),
            "external": None,
            "body": body,
        }
        branch = cwd_branch()
        if branch:
            task["branch"] = branch
        store.write(task)
    print(f"#{tid} создана: {task['title']}")
    if not args.md:
        print(f"тело: cctm set {tid} --md <file>")
    return 0


def cmd_set(args, store: Store) -> int:
    with locked(store):
        task = require(store, args.id)
        if args.md:
            incoming = parse_md(read_source(args.md))
        elif args.json:
            incoming = json.loads(read_source(args.json))
            if not isinstance(incoming, dict):
                raise CctmError("ожидался JSON-объект с полями body")
        else:
            raise CctmError("нужен --md или --json")
        task["body"] = merge_body(task.get("body") or {}, incoming, replace=args.replace)
        store.write(task)
    print(f"#{args.id} тело обновлено")
    return 0


def cmd_update(args, store: Store) -> int:
    with locked(store):
        task = require(store, args.id)
        tasks = {t["id"]: t for t in store.all()}
        if args.title:
            task["title"] = args.title.strip()
        if args.priority:
            if args.priority not in PRIORITIES:
                raise CctmError(f"приоритет: {', '.join(PRIORITIES)}")
            task["priority"] = args.priority
        if args.status:
            if args.status not in STATUSES:
                raise CctmError(f"статус: {', '.join(STATUSES)}")
            task["status"] = args.status
            task["closed"] = today() if args.status in TERMINAL else None
            task["closed_by"] = session_key(session_uuid()) if args.status in TERMINAL else None
        if args.tags is not None:
            task["tags"] = parse_tags(args.tags)
        if args.add_tag:
            tags = list(task.get("tags") or [])
            for tag in parse_tags(args.add_tag):
                if tag not in tags:
                    tags.append(tag)
            task["tags"] = tags
        if args.blocked_by is not None:
            blocked = parse_ids(args.blocked_by)
            missing = [b for b in blocked if b not in tasks]
            if missing:
                raise CctmError("нет таких задач: " + ", ".join(f"#{m}" for m in missing))
            if args.id in blocked:
                raise CctmError("задача не может блокировать саму себя")
            task["blockedBy"] = blocked
        if args.order is not None:
            task["order"] = args.order
        store.write(task)
    print(f"#{args.id} обновлена")
    return 0


def cmd_close(args, store: Store) -> int:
    with locked(store):
        task = require(store, args.id)
        if args.md:
            task["body"] = merge_body(task.get("body") or {}, parse_md(read_source(args.md)))
        task["status"] = "done"
        task["closed"] = today()
        task["closed_by"] = session_key(session_uuid())
        store.write(task)
    print(f"#{args.id} закрыта: {task['title']}")
    return 0


def cmd_reopen(args, store: Store) -> int:
    with locked(store):
        task = require(store, args.id)
        task["status"] = "open"
        task["closed"] = None
        task["closed_by"] = None
        store.write(task)
    print(f"#{args.id} открыта заново: {task['title']}")
    return 0


def cmd_delete(args, store: Store) -> int:
    with locked(store):
        task = require(store, args.id)
        if not args.force:
            raise CctmError(f"удаление #{args.id} требует --force")
        store.remove(args.id)
        for other in store.all():
            blocked = other.get("blockedBy") or []
            if args.id in blocked:
                other["blockedBy"] = [b for b in blocked if b != args.id]
                store.write(other, touch=False)
    print(f"#{args.id} удалена: {task['title']}")
    return 0


def select(tasks: list[dict], status: str, priority: str | None, tag: str | None) -> list[dict]:
    if status == "active":
        result = [t for t in tasks if t.get("status") in ACTIVE]
    elif status == "all":
        result = list(tasks)
    else:
        result = [t for t in tasks if t.get("status") == status]
    if priority:
        result = [t for t in result if t.get("priority") == priority]
    if tag:
        result = [t for t in result if tag in (t.get("tags") or [])]
    return sorted(result, key=sort_key)


def cmd_list(args, store: Store) -> int:
    tasks = store.all()
    by_id = {t["id"]: t for t in tasks}
    selected = sorted(select(tasks, args.status, args.priority, args.tag), key=branch_key(worktree_branch()))
    if args.json:
        json.dump(selected, sys.stdout, ensure_ascii=False, indent=2)
        print()
        return 0
    print_tasks(selected, by_id, "задач нет", live_marks(store))
    if args.status == "active":
        done = len([t for t in tasks if t.get("status") == "done"])
        if done:
            print(f"\nвыполнено: {done} (cctm list --status done)")
    return 0


def cmd_next(args, store: Store) -> int:
    branch = worktree_branch()
    ready, blocked, by_id = split_next(store, branch)
    ready = ready[: args.limit]
    if args.json:
        deferred = [t for t in by_id.values() if t.get("status") == "deferred"]
        json.dump(
            {"ready": ready, "blocked": blocked, "deferred": sorted(deferred, key=sort_key)},
            sys.stdout,
            ensure_ascii=False,
            indent=2,
        )
        print()
        return 0
    live = live_marks(store)
    own = [t for t in ready if branch and t.get("branch") == branch]
    if own and len(own) < len(ready):
        print(f"ветка {branch}:")
        print_tasks(own, by_id, "", live)
        print("\nостальные:")
        print_tasks(ready[len(own) :], by_id, "", live)
    else:
        print_tasks(ready, by_id, "открытых задач нет", live)
    if blocked:
        print("\nзаблокированы:")
        print_tasks(blocked, by_id, "", live)
    return 0


def cmd_show(args, store: Store) -> int:
    task = require(store, args.id)
    if args.json:
        json.dump(task, sys.stdout, ensure_ascii=False, indent=2)
        print()
        return 0
    if args.md:
        sys.stdout.write(render_md(task))
        return 0
    head = f"#{task['id']} {task['title']}"
    meta = f"{task.get('status')} · {task.get('priority')} · создана {task.get('created')}"
    if task.get("closed"):
        meta += f" · закрыта {task['closed']}"
    if task.get("tags"):
        meta += " · " + ",".join(task["tags"])
    if task.get("blockedBy"):
        meta += " · блокеры: " + ", ".join(f"#{b}" for b in task["blockedBy"])
    if task.get("external"):
        meta += f" · натив: {task['external'].get('session')}/{task['external'].get('id')}"
    if task.get("branch"):
        meta += f" · ветка {task['branch']}"
    if task.get("merged_from"):
        meta += f" · перенесена из {task['merged_from'].get('store')} как #{task['merged_from'].get('id')}"
    print(head)
    print(meta)
    print()
    sys.stdout.write(render_md(task, with_title=False))
    return 0


def cmd_grep(args, store: Store) -> int:
    pattern = re.compile(args.pattern, re.IGNORECASE)
    hits = []
    for task in store.all():
        haystack = [("title", task.get("title", ""))]
        body = task.get("body") or {}
        for field in TEXT_FIELDS:
            haystack.append((field, str(body.get(field) or "")))
        for field in LIST_FIELDS:
            haystack.extend((field, str(item)) for item in body.get(field) or [])
        for heading, value in (body.get("notes") or {}).items():
            haystack.append((heading, str(value)))
        matches = [(field, value) for field, value in haystack if value and pattern.search(value)]
        if matches:
            hits.append({"task": task, "matches": matches})
    if args.json:
        json.dump(
            [{"id": h["task"]["id"], "title": h["task"]["title"], "matches": [{"field": f, "text": v} for f, v in h["matches"]]} for h in hits],
            sys.stdout,
            ensure_ascii=False,
            indent=2,
        )
        print()
        return 0
    if not hits:
        print("совпадений нет")
        return 1
    for hit in hits:
        task = hit["task"]
        print(f"#{task['id']} {task.get('status')} {task['title']}")
        for field, value in hit["matches"][: args.context]:
            snippet = " ".join(value.split())
            if len(snippet) > 100:
                match = pattern.search(snippet)
                start = max(0, match.start() - 40)
                snippet = ("…" if start else "") + snippet[start : start + 100] + "…"
            print(f"    {field}: {snippet}")
    return 0


def cmd_export(args, store: Store) -> int:
    tasks = store.all()
    by_id = {t["id"]: t for t in tasks}
    lines = [f"# Задачи проекта\n", f"Обновлено: {today()}\n"]
    for status, heading in (("open", "Открытые"), ("deferred", "Отложенные"), ("done", "Выполненные"), ("cancelled", "Отменённые")):
        group = sorted([t for t in tasks if t.get("status") == status], key=sort_key)
        if not group:
            continue
        lines.append(f"## {heading}\n")
        for task in group:
            lines.append(f"### {format_row(task, by_id)}\n")
            lines.append(render_md(task, with_title=False))
            lines.append("")
    text = "\n".join(lines).rstrip() + "\n"
    if args.out:
        Path(args.out).write_text(text, encoding="utf-8")
        print(f"экспорт: {args.out}")
    else:
        sys.stdout.write(text)
    return 0


def cmd_doctor(args, store: Store) -> int:
    problems = []
    fixed = []
    if not store.exists():
        print("стор не инициализирован")
        return 0
    tasks = []
    for path in sorted(store.tasks_dir.glob("*.json")):
        try:
            task = read_json(path)
        except json.JSONDecodeError as exc:
            problems.append(f"{path.name}: не парсится ({exc})")
            continue
        if not isinstance(task.get("id"), int):
            problems.append(f"{path.name}: нет числового id")
            continue
        if path.stem != f"{task['id']:03d}":
            target = store.path_of(task["id"])
            if args.fix and not target.exists():
                os.replace(path, target)
                fixed.append(f"{path.name} → {target.name}")
            else:
                problems.append(f"{path.name}: имя файла не совпадает с id {task['id']}")
                continue
        tasks.append(task)

    seen: dict[int, str] = {}
    for task in tasks:
        tid = task["id"]
        if tid in seen:
            problems.append(f"#{tid}: дубль id")
        seen[tid] = task.get("title", "")
        if task.get("status") not in STATUSES:
            problems.append(f"#{tid}: статус {task.get('status')!r}")
        if task.get("priority") not in PRIORITIES:
            problems.append(f"#{tid}: приоритет {task.get('priority')!r}")
        closed_ok = bool(task.get("closed")) == (task.get("status") in TERMINAL)
        if not closed_ok:
            if args.fix:
                task["closed"] = today() if task.get("status") in TERMINAL else None
                store.write(task, touch=False)
                fixed.append(f"#{tid}: closed приведён к статусу")
            else:
                problems.append(f"#{tid}: closed не соответствует статусу")
        for field in ("created", "closed"):
            value = task.get(field)
            if value and not re.match(r"^\d{4}-\d{2}-\d{2}$", str(value)):
                problems.append(f"#{tid}: {field}={value!r} не дата")

    ids = set(seen)
    for task in tasks:
        for blocker in task.get("blockedBy") or []:
            if blocker not in ids:
                problems.append(f"#{task['id']}: блокер #{blocker} не существует")
            if blocker == task["id"]:
                problems.append(f"#{task['id']}: блокирует сам себя")
    cycle = find_cycle({t["id"]: [b for b in t.get("blockedBy") or [] if b in ids] for t in tasks})
    if cycle:
        problems.append("цикл блокировок: " + " → ".join(f"#{c}" for c in cycle))

    meta = store.meta()
    max_id = max(ids) if ids else 0
    if int(meta.get("next_id", 1)) <= max_id:
        if args.fix:
            meta["next_id"] = max_id + 1
            store.save_meta(meta)
            fixed.append(f"meta.next_id → {max_id + 1}")
        else:
            problems.append(f"meta.next_id={meta.get('next_id')} не больше max id {max_id}")
    if int(meta.get("version", 0)) != SCHEMA_VERSION:
        problems.append(f"версия схемы {meta.get('version')}, ожидается {SCHEMA_VERSION}")

    project = store.root.parent.parent.resolve()
    top = git_toplevel(project)
    if top == project:
        main = main_checkout(top)
        if main != top:
            problems.append(f"стор лежит в ворктри, основной чекаут {main}: cctm --root {main / '.claude' / 'session'} merge {store.root}")
        for path in worktree_paths(main)[1:]:
            fork = path / ".claude" / "session"
            if path != top and fork.is_dir():
                problems.append(f"у ворктри {path} свой стор: cctm --root {main / '.claude' / 'session'} merge {fork}")

    handoffs = 0
    for path in sorted(store.handoff_dir.glob("*.json")) if store.handoff_dir.is_dir() else []:
        try:
            record = read_json(path)
        except (json.JSONDecodeError, OSError) as exc:
            problems.append(f"handoff/{path.name}: не парсится ({exc})")
            continue
        if not record.get("ts") or not record.get("key"):
            problems.append(f"handoff/{path.name}: нет ts или key")
            continue
        handoffs += 1
    legacy = legacy_handoffs(store)
    if legacy and args.fix:
        with locked(store):
            fixed.append(f"handoff переименовано по дате и ветке: {rename_legacy_handoffs(store)}")
    elif legacy:
        problems.append(f"handoff со старыми именами <key>.json: {len(legacy)} (cctm doctor --fix)")

    for note in fixed:
        print(f"починено: {note}")
    if not problems:
        print(f"инвариантов нарушено нет · задач: {len(tasks)} · handoff: {handoffs}")
        return 0
    for note in problems:
        print(f"проблема: {note}")
    return 1


def find_cycle(graph: dict[int, list[int]]) -> list[int]:
    state: dict[int, int] = {}
    stack: list[int] = []

    def walk(node: int) -> list[int]:
        state[node] = 1
        stack.append(node)
        for nxt in graph.get(node, []):
            if state.get(nxt) == 1:
                return stack[stack.index(nxt) :] + [nxt]
            if state.get(nxt, 0) == 0:
                found = walk(nxt)
                if found:
                    return found
        stack.pop()
        state[node] = 2
        return []

    for node in graph:
        if state.get(node, 0) == 0:
            found = walk(node)
            if found:
                return found
    return []


def cmd_merge(args, store: Store) -> int:
    source_root = Path(args.source).expanduser().resolve()
    if (source_root / ".claude" / "session").is_dir():
        source_root = source_root / ".claude" / "session"
    source = Store(source_root)
    if not source.exists():
        raise CctmError(f"стор-источник не найден: {source_root}")
    if source.root.resolve() == store.root.resolve():
        raise CctmError("источник совпадает с целевым стором")
    incoming = source.all()
    records = read_handoffs(source)
    existing = store.all() if store.exists() else []
    known_keys = {r.get("key") for r in read_handoffs(store)}
    dups = {}
    for task in incoming:
        match = next((e for e in existing if titles_match(e.get("title", ""), task.get("title", ""))), None)
        if match is not None:
            dups[task["id"]] = match

    def plan() -> dict[int, int]:
        base = max([int(store.meta().get("next_id", 1)), *(t["id"] + 1 for t in store.all())])
        return {task["id"]: base + index for index, task in enumerate(incoming)}

    mapping = plan()
    print(f"перенос: {source.root} → {store.root}")
    for task in incoming:
        mark = f"  [возможный дубль #{dups[task['id']]['id']}]" if task["id"] in dups else ""
        print(f"  #{task['id']} → #{mapping[task['id']]} {task.get('status')} {str(task.get('title', ''))[:60]}{mark}")
    moved = [r for r in records if r.get("key") not in known_keys]
    skipped = [r for r in records if r.get("key") in known_keys]
    print(f"handoff: перенести {len(moved)}" + (f", уже есть: {', '.join(str(r.get('key')) for r in skipped)}" if skipped else ""))
    if args.dry_run:
        print("\ndry-run: ничего не записано")
        return 0

    with locked(store):
        store.init()
        mapping = plan()
        for task in incoming:
            copy = json.loads(json.dumps(task))
            copy["id"] = mapping[task["id"]]
            copy["blockedBy"] = [mapping[b] for b in task.get("blockedBy") or [] if b in mapping]
            copy["merged_from"] = {"store": str(source.root), "id": task["id"]}
            dup = dups.get(task["id"])
            if dup is not None:
                tags = list(copy.get("tags") or [])
                if "dup" not in tags:
                    tags.append("dup")
                copy["tags"] = tags
                if isinstance(copy.get("body"), dict):
                    notes = dict(copy["body"].get("notes") or {})
                    notes["Слияние"] = f"Возможный дубль #{dup['id']} «{dup.get('title', '')}». Сверь и закрой лишнюю."
                    copy["body"]["notes"] = notes
            store.write(copy, touch=False)
        meta = store.meta()
        meta["next_id"] = max(mapping.values(), default=int(meta.get("next_id", 1)) - 1) + 1
        store.save_meta(meta)
        store.handoff_dir.mkdir(parents=True, exist_ok=True)
        for record in moved:
            copy = {k: v for k, v in record.items() if k != "_path"}
            tasks = copy.get("tasks") or {}
            copy["tasks"] = {
                field: [mapping[int(i)] for i in tasks.get(field) or [] if int(i) in mapping]
                for field in ("closed", "created", "touched")
            }
            copy["worktree"] = handoff_place(copy) or str(source.root.parent.parent)
            copy["merged_from"] = str(source.root)
            folder = attachments_dir(Path(record["_path"]))
            if folder.is_dir():
                shutil.copytree(folder, attachments_dir(handoff_target(store, copy)), dirs_exist_ok=True)
            store_handoff(store, copy)
    print(f"\nперенесено задач: {len(incoming)}, handoff: {len(moved)}, возможных дублей: {len(dups)} (тег dup)")
    if not args.keep_source:
        target = source.root.with_name(f"session-merged-{today()}")
        suffix = 1
        while target.exists():
            suffix += 1
            target = source.root.with_name(f"session-merged-{today()}-{suffix}")
        source.root.rename(target)
        print(f"источник переименован: {target}")
    print("номера задач в текстах остались старыми — старый номер виден в cctm show N")
    return 0


# ---------------------------------------------------------------- sync

def claude_home() -> Path:
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")


def project_slug(path: Path) -> str:
    return str(path).replace("/", "-").replace(".", "-").replace("_", "-")


def native_dirs(store: Store) -> list[Path]:
    home = claude_home()
    dirs: list[Path] = []
    seen: set[Path] = set()
    for transcript in (t for folder in transcript_dirs(store) for t in folder.glob("*.jsonl")):
        uuid = transcript.stem
        for cand in (home / "tasks" / f"session-{uuid[:8]}", home / "tasks" / uuid):
            if cand.is_dir() and cand not in seen:
                seen.add(cand)
                dirs.append(cand)
    return dirs


def dir_mtime(path: Path) -> float:
    times = [path.stat().st_mtime]
    times.extend(f.stat().st_mtime for f in path.glob("*.json"))
    return max(times)


def read_native(path: Path) -> list[dict]:
    tasks = []
    for f in sorted(path.glob("*.json")):
        try:
            data = read_json(f)
        except (json.JSONDecodeError, OSError):
            continue
        if isinstance(data, dict) and data.get("subject"):
            tasks.append(data)
    return tasks


def normalize_title(title: str) -> str:
    return re.sub(r"[^\wа-яё]+", " ", title.lower()).strip()


def titles_match(a: str, b: str) -> bool:
    from difflib import SequenceMatcher
    na, nb = normalize_title(a), normalize_title(b)
    if not na or not nb:
        return False
    if na == nb:
        return True
    return SequenceMatcher(None, na, nb).ratio() >= 0.85


def cmd_sync(args, store: Store) -> int:
    global SESSION_OVERRIDE
    quiet = args.quiet
    if args.from_hook:
        payload = hook_payload()
        SESSION_OVERRIDE = session_uuid(payload.get("session_id"))
        root = hook_root(payload.get("cwd"))
        if root is None:
            return 0
        store = Store(root)
    if not store.exists():
        if not quiet:
            print(f"стор не найден: {store.root} — синк пропущен")
        return 0

    session_env = session_uuid()
    meta = store.meta()
    last_sync = float(meta.get("last_sync_ts") or 0)

    candidates = native_dirs(store)
    if args.session:
        wanted = args.session if args.session.startswith("session-") else f"session-{args.session[:8]}"
        candidates = [d for d in (claude_home() / "tasks" / wanted, claude_home() / "tasks" / args.session) if d.is_dir()]
    elif not args.all:
        current = f"session-{session_env[:8]}" if session_env else None
        cutoff = last_sync or (time.time() - 7 * 86400)
        candidates = [d for d in candidates if d.name == current or dir_mtime(d) > cutoff]

    if not candidates:
        if not quiet:
            print(f"нативный стор: подходящих сессий нет (искал в {claude_home() / 'tasks'} по транскриптам {', '.join(str(p) for p in project_places(store))})")
        return 0

    tasks = store.all()
    by_external: dict[tuple[str, str], dict] = {}
    for task in tasks:
        ext = task.get("external") or {}
        if ext.get("session") and ext.get("id"):
            by_external[(ext["session"], str(ext["id"]))] = task

    closed, created, linked, conflicts = [], [], [], []
    owners: dict[int, str] = {}
    for ndir in candidates:
        owner = session_key(session_uuid(ndir.name))
        for native in read_native(ndir):
            key = (ndir.name, str(native["id"]))
            native_done = native.get("status") in ("completed", "done", "cancelled")
            task = by_external.get(key)
            if task is None:
                match = next((t for t in tasks if titles_match(t.get("title", ""), native["subject"])), None)
                if match is not None:
                    task = match
                    if not (match.get("external") or {}).get("session"):
                        task["external"] = {"session": ndir.name, "id": str(native["id"])}
                        linked.append(task)
                        owners[id(task)] = owner
            if task is None:
                body = empty_body()
                body["description"] = native.get("description") or ""
                new = {
                    "id": None,
                    "title": native["subject"],
                    "status": "done" if native_done else "open",
                    "priority": "MEDIUM",
                    "order": None,
                    "created": today(),
                    "updated": today(),
                    "closed": today() if native_done else None,
                    "created_by": owner,
                    "closed_by": owner if native_done else None,
                    "blockedBy": [],
                    "tags": [],
                    "external": {"session": ndir.name, "id": str(native["id"])},
                    "body": body,
                }
                branch = cwd_branch()
                if branch:
                    new["branch"] = branch
                created.append(new)
                owners[id(new)] = owner
                tasks.append(new)
                by_external[key] = new
                continue
            if native_done and task.get("status") in ACTIVE:
                task["status"] = "done"
                task["closed"] = today()
                task["closed_by"] = owner
                closed.append(task)
                owners[id(task)] = owner
            elif not native_done and task.get("status") in TERMINAL:
                conflicts.append(task)

    if not (closed or created or linked or conflicts):
        if not quiet:
            print(f"синк: расхождений нет (сессий проверено: {len(candidates)})")
        if not args.dry_run:
            meta["last_sync_ts"] = time.time()
            store.save_meta(meta)
        return 0

    def report(label: str, items: list[dict]) -> None:
        if items and not quiet:
            print(f"{label}:")
            for t in items:
                mark = f"#{t['id']}" if t.get("id") else "новая"
                print(f"  {mark} {t['title'][:70]}")

    report("закрыто по нативному стору", closed)
    report("создано из нативного стора", created)
    report("связано по заголовку", linked)
    report("реестр прав, натив отстал (не тронуто)", conflicts)

    if args.dry_run:
        print("\ndry-run: ничего не записано")
        return 0

    with locked(store):
        for task in created:
            task["id"] = store.take_id()
        for task in closed + created + linked:
            store.write(task, by=owners.get(id(task)))
        meta = store.meta()
        meta["last_sync_ts"] = time.time()
        store.save_meta(meta)
    if not quiet:
        print(f"\nсинк завершён: закрыто {len(closed)}, создано {len(created)}, связано {len(linked)}")
    return 0


# ---------------------------------------------------------------- migrate

FRONTMATTER_RE = re.compile(r"^---\s*\n(.*?)\n---\s*\n?", re.DOTALL)
LEGACY_NAME_RE = re.compile(r"^(open|done|deferred|cancelled|superseded)-(\d+)-(.+)\.md$")
PREFIX_STATUS = {"open": "open", "deferred": "deferred", "done": "done", "cancelled": "cancelled", "superseded": "cancelled"}
INLINE_STATUS = {
    "DONE": "done", "CLOSED": "done", "OPEN": "open", "IN PROGRESS": "open",
    "TODO": "open", "TO TEST": "open", "CANCELLED": "cancelled", "ОТМЕНЕНО": "cancelled",
}


def parse_frontmatter(text: str) -> tuple[dict, str]:
    match = FRONTMATTER_RE.match(text)
    if not match:
        return {}, text
    data: dict = {}
    key = None
    for line in match.group(1).splitlines():
        if not line.strip():
            continue
        item = re.match(r"^\s*-\s+(.*)$", line)
        if item and key:
            data.setdefault(key, [])
            if isinstance(data[key], list):
                data[key].append(scalar(item.group(1)))
            continue
        pair = re.match(r"^([A-Za-z_][\w-]*)\s*:\s*(.*)$", line)
        if not pair:
            continue
        key = pair.group(1)
        raw = pair.group(2).strip()
        data[key] = [] if raw == "" else scalar(raw)
    return data, text[match.end() :]


def scalar(raw: str):
    raw = raw.strip()
    if raw.startswith("[") and raw.endswith("]"):
        inner = raw[1:-1].strip()
        if not inner:
            return []
        return [scalar(part) for part in re.split(r",(?![^\[]*\])", inner)]
    if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'":
        return raw[1:-1]
    low = raw.lower()
    if low in ("null", "none", "~"):
        return None
    if low == "true":
        return True
    if low == "false":
        return False
    if re.match(r"^-?\d+$", raw):
        return int(raw)
    return raw


def parse_legacy_index(text: str) -> dict[int, dict]:
    rows: dict[int, dict] = {}
    section = None
    for line in text.splitlines():
        heading = re.match(r"^##\s+(.+?)\s*$", line)
        if heading:
            name = heading.group(1).strip().lower()
            section = {"открытые": "open", "выполненные": "done", "отложенные": "deferred"}.get(name)
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")] if line.strip().startswith("|") else []
        if len(cells) < 2 or not cells[0].lstrip("#").isdigit() or not cells[1] or set(cells[1]) <= {"-"}:
            continue
        tid = int(cells[0].lstrip("#"))
        row = {"title": cells[1].replace("**", "").strip(), "status": section or "open"}
        for cell in cells[2:]:
            token = cell.strip().upper()
            if token in PRIORITIES:
                row["priority"] = token
            elif token in INLINE_STATUS:
                row["status"] = INLINE_STATUS[token]
            elif re.match(r"^\d{4}-\d{2}-\d{2}$", cell.strip()):
                row["closed"] = cell.strip()
        blocker = cells[3].strip() if len(cells) >= 4 else ""
        if blocker and blocker not in ("—", "-", "Нет") and blocker.upper() not in INLINE_STATUS:
            row["blocker_note"] = blocker
        rows[tid] = row
    return rows


PLAIN_STATUS_WORDS = {
    "открыта": "open", "открыт": "open", "в работе": "open",
    "закрыта": "done", "выполнена": "done", "сделана": "done", "готова": "done",
    "отменена": "cancelled", "отложена": "deferred",
}


def parse_plain_meta(text: str) -> dict:
    meta: dict = {}
    for line in text.splitlines()[:20]:
        pair = re.match(r"^(Создано|Приоритет|Статус)\s*:\s*(.+)$", line.strip())
        if not pair:
            continue
        key, value = pair.group(1), pair.group(2).strip()
        if key == "Создано" and re.match(r"^\d{4}-\d{2}-\d{2}", value):
            meta["created"] = value[:10]
        elif key == "Приоритет" and value.upper() in PRIORITIES:
            meta["priority"] = value.upper()
        elif key == "Статус":
            first = value.split("—")[0].split("(")[0].strip().lower()
            for word, status in PLAIN_STATUS_WORDS.items():
                if first.startswith(word):
                    meta["status"] = status
                    break
    return meta


def humanize_slug_title(title: str) -> str:
    slug = re.match(r"^(?:open|done|deferred|cancelled|superseded)-\d+-(.+)$", title)
    return slug.group(1).replace("-", " ") if slug else title


def classify_files(details: Path) -> tuple[list[dict], list[Path]]:
    entries: list[dict] = []
    skipped: list[Path] = []
    for path in sorted(details.rglob("*.md")) if details.is_dir() else []:
        raw = path.read_text(encoding="utf-8")
        front, rest = parse_frontmatter(raw)
        name = LEGACY_NAME_RE.match(path.name)
        front_id = front.get("id") if isinstance(front.get("id"), int) else None
        file_id = None
        date_hint = None
        if name:
            num = name.group(2)
            if len(num) == 8:
                try:
                    date_hint = date(int(num[:4]), int(num[4:6]), int(num[6:8])).isoformat()
                except ValueError:
                    pass
            elif int(num) < 10000:
                file_id = int(num)
        if front_id is None and file_id is None and name is None:
            skipped.append(path)
            continue
        entries.append({
            "path": path, "front": front, "body": rest, "name": name,
            "front_id": front_id, "file_id": file_id, "date_hint": date_hint,
        })
    return entries, skipped


def cmd_migrate(args, store: Store) -> int:
    root = store.root
    details = root / "details"
    index = root / "tasks.md"
    queue = root / "queue.md"
    if not details.is_dir() and not index.is_file():
        print(f"мигрировать нечего: {root}")
        return 0
    if store.tasks_dir.is_dir() and any(store.tasks_dir.glob("*.json")):
        raise CctmError(f"в {store.tasks_dir} уже есть задачи — миграция отменена")

    legacy_rows = parse_legacy_index(index.read_text(encoding="utf-8")) if index.is_file() else {}
    bogus_rows = [tid for tid in legacy_rows if tid >= 10000]
    for tid in bogus_rows:
        del legacy_rows[tid]
    entries, skipped = classify_files(details)

    # раздача id: сначала все frontmatter-id, потом имена файлов, потом свежие
    taken: set[int] = set()
    reassigned: list[tuple[Path, int]] = []
    for entry in entries:
        entry["id"] = None
        if entry["front_id"] is not None and entry["front_id"] not in taken:
            entry["id"] = entry["front_id"]
            taken.add(entry["front_id"])
    for entry in entries:
        if entry["id"] is None and entry["file_id"] is not None and entry["file_id"] not in taken:
            entry["id"] = entry["file_id"]
            taken.add(entry["file_id"])
    next_free = max(taken | set(legacy_rows), default=0) + 1
    for entry in entries:
        if entry["id"] is None:
            entry["id"] = next_free
            taken.add(next_free)
            reassigned.append((entry["path"], next_free))
            next_free += 1

    tasks: dict[int, dict] = {}
    for entry in entries:
        front, rest, name = entry["front"], entry["body"], entry["name"]
        tid = entry["id"]
        row = legacy_rows.get(tid, {})
        plain = parse_plain_meta(rest) if not front else {}
        status = front.get("status") if front.get("status") in STATUSES else None
        if status is None and name:
            status = PREFIX_STATUS[name.group(1)]
        if status is None:
            status = plain.get("status") or row.get("status", "open")
        title_match = re.search(r"^#\s+(.+?)\s*$", rest, re.MULTILINE)
        title = (title_match.group(1).strip() if title_match
                 else row.get("title") or (name.group(3).replace("-", " ") if name else entry["path"].stem))
        title = humanize_slug_title(title)
        external = None
        if front.get("external_id"):
            external = {"session": None, "id": str(front["external_id"]), "unverified": True}
        blocked_raw = front.get("blockedBy") or []
        blocked_ids = [b for b in blocked_raw if isinstance(b, int)]
        blocked_notes = [str(b) for b in blocked_raw if not isinstance(b, int) and b is not None]
        if row.get("blocker_note") and not any(row["blocker_note"] in n or n in row["blocker_note"] for n in blocked_notes):
            blocked_notes.append(row["blocker_note"])
        body = parse_md(rest)
        if blocked_notes:
            body["notes"]["Блокер (из 1.x)"] = "; ".join(blocked_notes)
        created = str(front.get("created") or plain.get("created") or entry["date_hint"] or today())
        closed = None
        if status in TERMINAL:
            closed = str(front.get("closed") or row.get("closed") or entry["date_hint"] or created)
        tags = [str(t) for t in (front.get("tags") or [])]
        if name and name.group(1) == "superseded" and "superseded" not in tags:
            tags.append("superseded")
        tasks[tid] = {
            "id": tid,
            "title": title,
            "status": status,
            "priority": (front.get("priority") if front.get("priority") in PRIORITIES
                         else plain.get("priority") or row.get("priority", "MEDIUM")),
            "order": None,
            "created": created,
            "updated": today(),
            "closed": closed,
            "blockedBy": blocked_ids,
            "tags": tags,
            "external": external,
            "body": body,
        }
        entry["final_id"] = tid

    for tid, row in legacy_rows.items():
        if tid in tasks:
            continue
        body = empty_body()
        body["notes"]["Перенос из 1.x"] = "Задача была только в tasks.md, detail-файла не существовало."
        if row.get("blocker_note"):
            body["notes"]["Блокер (из 1.x)"] = row["blocker_note"]
        status = row["status"]
        tasks[tid] = {
            "id": tid,
            "title": row["title"],
            "status": status,
            "priority": row.get("priority", "MEDIUM"),
            "order": None,
            "created": row.get("closed") or today(),
            "updated": today(),
            "closed": (row.get("closed") or today()) if status in TERMINAL else None,
            "blockedBy": [],
            "tags": [],
            "external": None,
            "body": body,
        }

    known = set(tasks)
    for task in tasks.values():
        dropped = [b for b in task["blockedBy"] if b not in known]
        if dropped:
            task["blockedBy"] = [b for b in task["blockedBy"] if b in known]
            note = task["body"]["notes"].get("Блокер (из 1.x)", "")
            extra = "несуществующие: " + ", ".join(f"#{d}" for d in dropped)
            task["body"]["notes"]["Блокер (из 1.x)"] = f"{note}; {extra}".strip("; ")

    plan = sorted(tasks.values(), key=lambda t: t["id"])
    by_status = {}
    for task in plan:
        by_status[task["status"]] = by_status.get(task["status"], 0) + 1
    print(f"стор: {root}")
    print(f"задач к переносу: {len(plan)} (из файлов: {len(entries)}, только из tasks.md: {len(plan) - len(entries)})")
    print("по статусам: " + ", ".join(f"{s}={n}" for s, n in sorted(by_status.items())))
    if reassigned:
        print(f"переназначено id (дубль или дата в имени): {len(reassigned)}")
        for path, tid in reassigned[: args.preview]:
            print(f"  {path.relative_to(details)} → #{tid}")
        if len(reassigned) > args.preview:
            print(f"  … ещё {len(reassigned) - args.preview}")
    if skipped:
        print(f"не задачи, останутся на месте: {len(skipped)}")
        for path in skipped:
            print(f"  {path.relative_to(root)}")
    if args.preview:
        for task in plan[: args.preview]:
            print(f"  #{task['id']:<5} {task['status']:<9} {task['priority']:<7} {task['title'][:60]}")
        if len(plan) > args.preview:
            print(f"  … ещё {len(plan) - args.preview}")

    if args.dry_run:
        print("\ndry-run: ничего не записано")
        if queue.is_file():
            print("queue.md будет перенесён в бэкап — его содержимое схлопни в тела задач вручную")
        return 0

    backup = root.parent / f"session.bak-{today().replace('-', '')}"
    suffix = 1
    while backup.exists():
        backup = root.parent / f"session.bak-{today().replace('-', '')}-{suffix}"
        suffix += 1
    shutil.copytree(root, backup)
    print(f"\nбэкап: {backup}")

    with locked(store):
        store.init()
        for task in plan:
            store.write(task, touch=False)
        meta = store.meta()
        meta["version"] = SCHEMA_VERSION
        meta["next_id"] = max(known) + 1 if known else 1
        store.save_meta(meta)

    for entry in entries:
        entry["path"].unlink()
    for path in (index, queue):
        if path.is_file():
            path.unlink()
            print(f"удалено (копия в бэкапе): {path.name}")
    for dirpath in sorted(details.rglob("*"), reverse=True):
        if dirpath.is_dir():
            with contextlib.suppress(OSError):
                dirpath.rmdir()
    with contextlib.suppress(OSError):
        details.rmdir()
    print(f"перенесено: {len(plan)} задач → {store.tasks_dir}")
    if skipped:
        print("непереносимые файлы оставлены в details/ — разбери вручную:")
        for path in skipped:
            print(f"  {path.relative_to(root)}")
    if queue.name and (backup / "queue.md").exists():
        print("queue.md ушёл в бэкап — схлопни его содержимое в тела задач при следующем /finalize")
    if args.preview:
        print("\nкарта переноса (проверь ссылки в CLAUDE.md, memory, ADR):")
        for entry in entries[: args.preview]:
            print(f"  details/{entry['path'].relative_to(details)} → tasks/{entry['final_id']:03d}.json")
        if len(entries) > args.preview:
            print(f"  … ещё {len(entries) - args.preview}")
    else:
        print(f"старые имена файлов больше не существуют — проверь ссылки на details/ в CLAUDE.md, memory, ADR")
        print(f"полная карта: cctm --root {store.root} migrate --dry-run (по бэкапу) или см. {backup}")
    return 0


# ---------------------------------------------------------------- handoff

def hook_payload() -> dict:
    try:
        if sys.stdin is None or sys.stdin.closed or sys.stdin.isatty():
            return {}
        data = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError, OSError):
        return {}
    return data if isinstance(data, dict) else {}


SESSION_OVERRIDE = ""


def session_uuid(explicit: str | None = None) -> str:
    value = (explicit or SESSION_OVERRIDE or os.environ.get("CLAUDE_CODE_SESSION_ID") or "").strip()
    return value[len("session-") :] if value.startswith("session-") else value


def session_key(uuid: str) -> str:
    return uuid[:8] if uuid else "unknown"


def parse_iso_ts(value) -> float | None:
    from datetime import datetime

    try:
        return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()
    except (ValueError, TypeError):
        return None


def git_state(project_root: Path) -> dict:
    def run(*cmd: str) -> str | None:
        try:
            done = subprocess.run(cmd, cwd=str(project_root), capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.SubprocessError):
            return None
        return done.stdout.strip() if done.returncode == 0 else None

    branch = run("git", "rev-parse", "--abbrev-ref", "HEAD") or run("git", "symbolic-ref", "--short", "HEAD")
    if branch is None:
        return {}
    status = run("git", "status", "--porcelain") or ""
    return {
        "branch": branch,
        "head": run("git", "rev-parse", "--short", "HEAD") or "",
        "dirty": len([line for line in status.splitlines() if line.strip()]),
    }


def find_transcript(uuid: str, places: list[Path] | None = None) -> Path | None:
    if not uuid:
        return None
    base = claude_home() / "projects"
    for place in places or []:
        exact = base / project_slug(place) / f"{uuid}.jsonl"
        if exact.is_file():
            return exact
    if not base.is_dir():
        return None
    matches = sorted(base.glob(f"*/{uuid}.jsonl"))
    if not matches and len(uuid) < 36:
        matches = sorted(base.glob(f"*/{uuid}*.jsonl"))
    return matches[0] if matches else None


def transcript_cwd(path: Path) -> str | None:
    try:
        with path.open(encoding="utf-8") as fh:
            for index, line in enumerate(fh):
                if index >= 50:
                    break
                try:
                    data = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if isinstance(data, dict) and data.get("cwd"):
                    return str(data["cwd"])
    except (OSError, UnicodeDecodeError):
        return None
    return None


def pid_alive(pid: int) -> bool:
    if os.name != "posix":
        return True
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True


def live_registry() -> list[dict] | None:
    folder = claude_home() / "sessions"
    if not folder.is_dir():
        return None
    entries = []
    for path in folder.glob("*.json"):
        try:
            data = read_json(path)
            pid = int(data.get("pid") or 0)
        except (json.JSONDecodeError, OSError, ValueError, TypeError, AttributeError):
            continue
        if pid and data.get("sessionId") and pid_alive(pid):
            entries.append(data)
    return entries


def session_anchor(uuid: str | None = None) -> Path | None:
    env = os.environ.get("CLAUDE_PROJECT_DIR")
    if env:
        return Path(env).resolve()
    uuid = session_uuid(uuid)
    if not uuid:
        return None
    for entry in live_registry() or []:
        if entry.get("sessionId") == uuid and entry.get("cwd"):
            return Path(str(entry["cwd"])).resolve()
    path = find_transcript(uuid)
    cwd = transcript_cwd(path) if path else None
    return Path(cwd).resolve() if cwd else None


def cwd_branch(cwd: str | None = None) -> str:
    try:
        return head_branch(git_toplevel(Path(cwd or os.getcwd()).resolve()))
    except OSError:
        return ""


def worktree_branch(cwd: str | None = None) -> str:
    try:
        top = git_toplevel(Path(cwd or os.getcwd()).resolve())
    except OSError:
        return ""
    if top is None or main_checkout(top) == top:
        return ""
    return head_branch(top)


def work_place(store: Store, cwd: str | None = None) -> tuple[Path, str, Path | None]:
    try:
        top = git_toplevel(Path(cwd or os.getcwd()).resolve())
    except OSError:
        top = None
    if top is None:
        return store.root.parent.parent.resolve(), "", None
    return top, head_branch(top), top


def handoff_place(record: dict) -> str:
    return str(record.get("worktree") or record.get("cwd") or "")


def handoff_branch(record: dict) -> str:
    branch = str((record.get("git") or {}).get("branch") or "")
    return "" if branch == "HEAD" else branch


def project_places(store: Store) -> list[Path]:
    if store._places is not None:
        return store._places
    root = store.root.parent.parent.resolve()
    places = [root]
    top = git_toplevel(root)
    if top is not None:
        places.extend(p for p in worktree_paths(main_checkout(top)) if p not in places)
    for record in read_handoffs(store):
        place = handoff_place(record)
        if place and Path(place) not in places:
            places.append(Path(place))
    store._places = places
    return places


def transcript_dirs(store: Store) -> list[Path]:
    base = claude_home() / "projects"
    dirs = []
    for place in project_places(store):
        folder = base / project_slug(place)
        if folder.is_dir() and folder not in dirs:
            dirs.append(folder)
    return dirs


def owning_place(path: Path, places: list[Path]) -> Path | None:
    for place in sorted(places, key=lambda p: len(str(p)), reverse=True):
        if is_within(path, place):
            return place
    return None


def live_neighbours(store: Store, own: str) -> list[dict]:
    places = project_places(store)
    now = time.time()
    found = []
    registry = live_registry()
    if registry is not None:
        for entry in registry:
            uuid = str(entry.get("sessionId"))
            if uuid == own or not entry.get("cwd"):
                continue
            place = owning_place(Path(str(entry["cwd"])).resolve(), places)
            if place is None:
                continue
            status = str(entry.get("status") or "")
            stamp = float(entry.get("updatedAt") or entry.get("startedAt") or 0) / 1000
            age = 0.0 if status == "busy" else max(0.0, now - stamp)
            found.append({"key": session_key(uuid), "place": place, "age": age, "status": status})
        return found
    cutoff = now - LIVE_MINUTES * 60
    base = claude_home() / "projects"
    for place in places:
        for path in (base / project_slug(place)).glob("*.jsonl"):
            if path.stem == own:
                continue
            with contextlib.suppress(OSError):
                mtime = path.stat().st_mtime
                if mtime >= cutoff:
                    found.append({"key": session_key(path.stem), "place": place, "age": now - mtime, "status": ""})
    return found


def fmt_age(seconds: float) -> str:
    minutes = int(seconds // 60)
    if minutes < 1:
        return "сейчас"
    if minutes < 60:
        return f"{minutes} мин назад"
    return f"{minutes // 60} ч назад"


def live_marks(store: Store) -> dict[str, str]:
    own = session_uuid()
    try:
        neighbours = live_neighbours(store, own)
    except OSError:
        return {}
    return {n["key"]: f"сессия {n['key']} ({fmt_age(n['age'])})" for n in neighbours if n["key"] != session_key(own)}


def transcript_started_at(path: Path) -> float | None:
    try:
        with path.open(encoding="utf-8") as fh:
            for index, line in enumerate(fh):
                if index >= 5:
                    break
                if not line.strip():
                    continue
                try:
                    data = json.loads(line)
                except json.JSONDecodeError:
                    continue
                stamp = parse_iso_ts(data.get("timestamp")) if isinstance(data, dict) else None
                if stamp:
                    return stamp
    except OSError:
        return None
    return None


def session_window(store: Store, uuid: str) -> tuple[float | None, float | None]:
    path = find_transcript(uuid, project_places(store))
    if path is None:
        return None, None
    try:
        return transcript_started_at(path), path.stat().st_mtime
    except OSError:
        return None, None


def session_tasks(store: Store, uuid: str) -> tuple[list[dict], list[dict], list[dict]]:
    key = session_key(uuid)
    if key == "unknown" or not store.tasks_dir.is_dir():
        return [], [], []
    mine = [
        t for t in store.all()
        if key in (t.get("session"), t.get("created_by"), t.get("closed_by")) or key in (t.get("touched_by") or [])
    ]
    closed = [t for t in mine if t.get("status") in TERMINAL and t.get("closed_by") == key]
    done_ids = {t["id"] for t in closed}
    created = [t for t in mine if t.get("created_by") == key and t["id"] not in done_ids]
    known = done_ids | {t["id"] for t in created}
    rest = [t for t in mine if t["id"] not in known and t.get("status") not in TERMINAL]
    return closed, created, rest


def split_task_groups(closed: list[int], created: list[int], touched: list[int]) -> dict[str, list[int]]:
    seen: set[int] = set()
    groups: dict[str, list[int]] = {}
    for field, ids in (("closed", closed), ("created", created), ("touched", touched)):
        unique = []
        for task_id in (int(i) for i in ids):
            if task_id not in seen:
                seen.add(task_id)
                unique.append(task_id)
        groups[field] = unique
    return groups


def read_handoffs(store: Store) -> list[dict]:
    if not store.handoff_dir.is_dir():
        return []
    records = []
    for path in sorted(store.handoff_dir.glob("*.json")):
        try:
            data = read_json(path)
        except (json.JSONDecodeError, OSError):
            continue
        if isinstance(data, dict) and data.get("ts"):
            data["_path"] = str(path)
            records.append(data)
    return sorted(records, key=lambda r: float(r.get("ts") or 0), reverse=True)


def own_handoff(records: list[dict], place: Path, branch: str) -> dict | None:
    here = str(place)
    tests = (
        lambda r: handoff_place(r) == here and handoff_branch(r) == branch,
        lambda r: bool(branch) and handoff_branch(r) == branch,
        lambda r: handoff_place(r) == here,
    )
    for test in tests:
        for record in records:
            if test(record):
                return record
    return None


def handoff_where(record: dict, place: Path | None, branch: str) -> str:
    if place is None:
        return ""
    parts = []
    record_place = handoff_place(record)
    if record_place and record_place != str(place):
        parts.append(f"ворктри {Path(record_place).name}")
    record_branch = handoff_branch(record)
    if record_branch and record_branch != branch:
        parts.append(f"ветка {record_branch}")
    return ", ".join(parts)


def handoff_tasks(record: dict) -> set[int]:
    tasks = record.get("tasks") or {}
    return {int(i) for field in ("closed", "created", "touched") for i in tasks.get(field) or []}


def handoff_matches(record: dict, query: str) -> bool:
    needle = query.strip().lower()
    stamps = [handoff_stamp(record)]
    if record.get("created_ts"):
        stamps.append(time.strftime("%Y-%m-%d %H:%M", time.localtime(float(record["created_ts"]))))
    place = handoff_place(record)
    fields = [
        str(record.get("key") or ""),
        str(record.get("session") or ""),
        handoff_branch(record),
        Path(place).name if place else "",
        handoff_title(record),
        Path(str(record.get("_path") or "")).name,
        *stamps,
    ]
    return any(needle in field.lower() for field in fields if field)


def select_handoffs(records: list[dict], query: str | None, task: int | None = None) -> list[dict]:
    found = [r for r in records if task is None or task in handoff_tasks(r)]
    if not query or query == "latest":
        return found
    key = session_key(session_uuid(query))
    exact = [r for r in found if r.get("key") == key or str(r.get("session") or "") == query]
    return exact or [r for r in found if handoff_matches(r, query)]


def pick_handoff(
    records: list[dict], wanted: str | None, place: Path | None = None, branch: str = "", task: int | None = None
) -> list[dict]:
    found = select_handoffs(records, wanted, task)
    if found and (not wanted or wanted == "latest") and place is not None:
        own = own_handoff(found, place, branch)
        if own is not None:
            found = [own] + [r for r in found if r is not own]
    return found


def prune_handoffs(store: Store, keep: int, days: int = 0) -> int:
    records = read_handoffs(store)
    protected: set[str] = set()
    per_place: dict[tuple[str, str], int] = {}
    for record in records:
        group = (handoff_place(record), handoff_branch(record))
        if per_place.get(group, 0) < HANDOFF_KEEP_PER_PLACE:
            per_place[group] = per_place.get(group, 0) + 1
            protected.add(record["_path"])
    doomed = [r for r in records[keep:] if r["_path"] not in protected] if keep > 0 else []
    if days > 0:
        cutoff = time.time() - days * 86400
        gone = {r["_path"] for r in doomed}
        doomed.extend(r for r in records if r["_path"] not in gone and float(r.get("ts") or 0) < cutoff)
    for record in doomed:
        with contextlib.suppress(OSError):
            Path(record["_path"]).unlink()
        shutil.rmtree(attachments_dir(Path(record["_path"])), ignore_errors=True)
    return len(doomed)


def first_line(text: str) -> str:
    for line in (text or "").splitlines():
        if line.strip():
            return re.sub(r"^#+\s*", "", line.strip())
    return ""


def h1_of(text: str) -> str:
    for line in (text or "").splitlines():
        heading = re.match(r"^#\s+(.+?)\s*$", line.strip())
        if heading:
            return heading.group(1)
    return ""


def handoff_stamp(record: dict) -> str:
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(float(record.get("ts") or 0)))


def handoff_title(record: dict) -> str:
    return record.get("title") or first_line(record.get("body") or "")


def wrote_after_handoff(store: Store, record: dict) -> bool:
    _, last = session_window(store, str(record.get("session") or ""))
    return bool(last and last > float(record.get("ts") or 0) + 300)


def task_lines(store: Store, ids: list[int]) -> list[str]:
    lines = []
    for tid in ids:
        task = store.read(int(tid))
        if task is None:
            lines.append(f"#{tid} (нет в реестре)")
        else:
            lines.append(f"#{tid} {task.get('status')} {str(task.get('title') or '')[:60]}")
    return lines


def handoff_head(record: dict, current: str, where: str = "") -> str:
    git = record.get("git") or {}
    ref = git.get("branch") or ""
    if ref and git.get("head"):
        ref += f"@{git['head']}"
    if ref and git.get("dirty"):
        ref += f", не закоммичено файлов: {git['dirty']}"
    marks = []
    if record.get("key") == current:
        marks.append("эта сессия")
    if record.get("kind") == "auto":
        marks.append("авто, без финализации")
    if where:
        marks.append(f"другое место — {where}")
    head = f"Handoff {record.get('key')} · {handoff_stamp(record)}"
    if ref:
        head += f" · {ref}"
    if marks:
        head += " · " + ", ".join(marks)
    return head


def strip_h1(text: str, title: str) -> str:
    lines = (text or "").splitlines()
    for index, line in enumerate(lines):
        if not line.strip():
            continue
        heading = re.match(r"^#\s+(.+?)\s*$", line.strip())
        if heading and heading.group(1).strip() == title.strip():
            return "\n".join(lines[index + 1 :]).strip()
        break
    return (text or "").strip()


def render_handoff(record: dict, store: Store, current: str, where: str = "") -> str:
    out = [f"# {handoff_head(record, current, where)}", ""]
    title = record.get("title")
    if title:
        out.extend([f"**{title}**", ""])
    place = handoff_place(record)
    if place and Path(place) != store.root.parent.parent.resolve():
        out.extend([f"ворктри: {place}", ""])
    tasks = record.get("tasks") or {}
    for field, label in (("closed", "Закрыто"), ("created", "Заведено"), ("touched", "Тронуто")):
        ids = [int(i) for i in tasks.get(field) or []]
        if not ids:
            continue
        out.append(f"## {label}")
        out.extend(f"- {line}" for line in task_lines(store, ids))
        out.append("")
    attachments = record.get("attachments") or []
    if attachments:
        out.append("## Вложения")
        if record.get("_path"):
            out.append(f"каталог: {attachments_dir(Path(record['_path']))}")
        out.extend(f"- {a.get('name')} ({fmt_size(int(a.get('bytes') or 0))})" for a in attachments)
        out.append("")
    body = strip_h1(record.get("body") or "", record.get("title") or "")
    if body:
        out.extend([body, ""])
    return "\n".join(out).rstrip() + "\n"


def slug_part(text: str) -> str:
    return re.sub(r"[^A-Za-z0-9.-]+", "-", text).strip("-.")[:40].strip("-.")


def handoff_filename(record: dict) -> str:
    stamp = time.strftime("%Y-%m-%d_%H%M", time.localtime(float(record.get("created_ts") or record.get("ts") or 0)))
    branch = slug_part(handoff_branch(record))
    return "_".join([stamp, *([branch] if branch else []), str(record["key"])]) + ".json"


def handoff_files(store: Store, key: str) -> list[Path]:
    if not store.handoff_dir.is_dir():
        return []
    return sorted(
        p for p in store.handoff_dir.glob(f"*{key}.json")
        if p.name == f"{key}.json" or p.name.endswith(f"_{key}.json")
    )


def attachments_dir(path: Path) -> Path:
    return path.with_suffix("")


def handoff_target(store: Store, record: dict) -> Path:
    existing = handoff_files(store, record["key"])
    if not record.get("created_ts"):
        first = None
        for old in existing:
            with contextlib.suppress(json.JSONDecodeError, OSError):
                data = read_json(old)
                first = data.get("created_ts") or data.get("ts")
                break
        record["created_ts"] = first or record.get("ts")
    current = next((p for p in existing if p.name != f"{record['key']}.json"), None)
    return current or store.handoff_dir / handoff_filename(record)


def store_handoff(store: Store, record: dict) -> Path:
    store.handoff_dir.mkdir(parents=True, exist_ok=True)
    data = {k: v for k, v in record.items() if k != "_path"}
    path = handoff_target(store, data)
    write_json(path, data)
    for old in handoff_files(store, data["key"]):
        if old == path:
            continue
        folder = attachments_dir(old)
        if folder.is_dir() and not attachments_dir(path).exists():
            folder.rename(attachments_dir(path))
        old.unlink(missing_ok=True)
    return path


def legacy_handoffs(store: Store) -> list[dict]:
    return [r for r in read_handoffs(store) if Path(r["_path"]).name == f"{r.get('key')}.json"]


def rename_legacy_handoffs(store: Store) -> int:
    renamed = 0
    for record in legacy_handoffs(store):
        with contextlib.suppress(OSError):
            store_handoff(store, record)
            renamed += 1
    return renamed


def write_handoff(store: Store, record: dict, keep: int) -> int:
    with locked(store):
        rename_legacy_handoffs(store)
        store_handoff(store, record)
        return prune_handoffs(store, keep)


def path_bytes(path: Path) -> int:
    if path.is_file():
        return path.stat().st_size
    return sum(f.stat().st_size for f in path.rglob("*") if f.is_file())


def fmt_size(size: int) -> str:
    if size < 1024:
        return f"{size} Б"
    if size < 1024 * 1024:
        return f"{size / 1024:.0f} КБ"
    return f"{size / 1024 / 1024:.1f} МБ"


def attachment_list(folder: Path) -> list[dict]:
    if not folder.is_dir():
        return []
    return [
        {"name": entry.name + ("/" if entry.is_dir() else ""), "bytes": path_bytes(entry)}
        for entry in sorted(folder.iterdir())
    ]


def check_attachments(sources: list[str], folder: Path) -> list[Path]:
    paths = [Path(s).expanduser().resolve() for s in sources]
    missing = [str(p) for p in paths if not p.exists()]
    if missing:
        raise CctmError("вложение не найдено: " + ", ".join(missing))
    nested = [str(p) for p in paths if is_within(folder, p)]
    if nested:
        raise CctmError("вложение содержит сам стор: " + ", ".join(nested))
    total = sum(path_bytes(p) for p in paths) + (path_bytes(folder) if folder.is_dir() else 0)
    if total > HANDOFF_ATTACH_MAX_MB * 1024 * 1024:
        raise CctmError(f"вложения {fmt_size(total)}, максимум {HANDOFF_ATTACH_MAX_MB} МБ: приложи скрипты и выжимку, не дампы")
    return paths


def copy_attachments(paths: list[Path], folder: Path) -> None:
    folder.mkdir(parents=True, exist_ok=True)
    for path in paths:
        if path.is_dir():
            shutil.copytree(path, folder / path.name, dirs_exist_ok=True)
        else:
            shutil.copy2(path, folder / path.name)


def cmd_handoff_write(args, store: Store) -> int:
    uuid = session_uuid(args.session)
    text = read_source(args.md).strip()
    if not text:
        raise CctmError("тело handoff пустое")
    if len(text) > HANDOFF_MAX_CHARS:
        raise CctmError(f"тело {len(text)} символов, максимум {HANDOFF_MAX_CHARS}: handoff — сводка, не дневник")
    with locked(store):
        store.init()
    auto_closed, auto_created, auto_touched = session_tasks(store, uuid)
    groups = split_task_groups(
        parse_ids(args.closed) or [t["id"] for t in auto_closed],
        parse_ids(args.created) or [t["id"] for t in auto_created],
        parse_ids(args.touched) or [t["id"] for t in auto_touched],
    )
    closed, created, touched = groups["closed"], groups["created"], groups["touched"]
    place, _, top = work_place(store)
    record = {
        "version": HANDOFF_VERSION,
        "key": session_key(uuid),
        "session": uuid,
        "kind": "final",
        "ts": time.time(),
        "date": today(),
        "title": (args.title or h1_of(text)).strip()[:120],
        "cwd": os.getcwd(),
        "worktree": str(place),
        "git": git_state(top) if top else {},
        "tasks": {"closed": closed, "created": created, "touched": touched},
        "body": text,
    }
    folder = attachments_dir(handoff_target(store, record))
    if args.attach:
        copy_attachments(check_attachments(args.attach, folder), folder)
    if folder.is_dir():
        record["attachments"] = attachment_list(folder)
    dropped = write_handoff(store, record, args.keep)
    if not args.quiet:
        print(f"handoff {record['key']} записан · закрыто {len(closed)}, заведено {len(created)}, тронуто {len(touched)}")
        if record.get("attachments"):
            print(f"вложения: {folder}")
        if dropped:
            print(f"вытеснено старых handoff: {dropped}")
    return 0


def auto_title(tasks: list[dict]) -> str:
    parts = []
    for task in tasks[:3]:
        title = str(task.get("title") or "")
        parts.append(f"#{task['id']} " + (title if len(title) <= 40 else title[:39] + "…"))
    more = f" и ещё {len(tasks) - 3}" if len(tasks) > 3 else ""
    return ("без финализации: " + "; ".join(parts) + more)[:120]


def cmd_handoff_auto(args, store: Store) -> int:
    uuid = session_uuid(args.session)
    if not uuid or not store.exists():
        return 0
    cwd = getattr(args, "cwd", None) or os.getcwd()
    place, _, top = work_place(store, cwd)
    closed, created, rest = session_tasks(store, uuid)
    touched = closed + created + rest
    if not touched:
        return 0
    key = session_key(uuid)
    files = handoff_files(store, key)
    path = next((f for f in files if f.name != f"{key}.json"), files[0] if files else None)
    previous = None
    if path is not None:
        with contextlib.suppress(json.JSONDecodeError, OSError):
            existing = read_json(path)
            newest = max((store.path_of(t["id"]).stat().st_mtime for t in touched), default=0)
            if existing.get("kind") == "final":
                if float(existing.get("ts") or 0) >= newest:
                    return 0
                previous = existing
    if previous is not None:
        seen = set()
        for field in ("closed", "created", "touched"):
            seen.update(int(i) for i in (previous.get("tasks") or {}).get(field) or [])
        fresh = [t for t in touched if t["id"] not in seen]
        lines = ["## После финализации",
                 "Сессия работала после /finalize и закрылась без повторной финализации."]
        if fresh:
            lines.extend(f"- #{t['id']} {t.get('status')} {t.get('title', '')}" for t in fresh)
        else:
            lines.append("Новых задач нет, менялись уже перечисленные — сверься с `cctm show N`.")
        merged = dict(previous.get("tasks") or {})
        was = {f: [int(i) for i in merged.get(f) or []] for f in ("closed", "created", "touched")}
        merged.update(split_task_groups(
            was["closed"] + [t["id"] for t in closed],
            was["created"] + [t["id"] for t in created],
            was["touched"] + [t["id"] for t in rest],
        ))
        record = dict(previous)
        record.update({
            "ts": time.time(),
            "date": today(),
            "worktree": str(place),
            "git": git_state(top) if top else {},
            "tasks": merged,
            "body": (previous.get("body") or "").strip() + "\n\n" + "\n".join(lines),
        })
        write_handoff(store, record, args.keep)
        if not args.quiet:
            print(f"handoff {key} дополнен после финализации · новых задач {len(fresh)}")
        return 0
    lines = [
        "## Состояние",
        "Сессия закончилась без /finalize — handoff собран автоматически по изменениям реестра.",
        "Списки выше полные, текста от модели нет: тела задач могут быть неполными, сверься с `cctm show N`.",
    ]
    record = {
        "version": HANDOFF_VERSION,
        "key": key,
        "session": uuid,
        "kind": "auto",
        "ts": time.time(),
        "date": today(),
        "title": auto_title(touched),
        "cwd": cwd,
        "worktree": str(place),
        "git": git_state(top) if top else {},
        "tasks": split_task_groups([t["id"] for t in closed], [t["id"] for t in created], [t["id"] for t in rest]),
        "body": "\n".join(lines).strip(),
    }
    write_handoff(store, record, args.keep)
    if not args.quiet:
        print(f"handoff {key} записан автоматически · закрыто {len(closed)}, заведено {len(created)}, в работе {len(rest)}")
    return 0


def handoff_group_label(group: tuple[str, str], here: tuple[str, str]) -> str:
    place, branch = group
    parts = ["здесь"] if group == here else []
    if branch:
        parts.append(f"ветка {branch}")
    if place:
        parts.append(place)
    return " · ".join(parts) + ":"


def cmd_handoff_list(args, store: Store) -> int:
    records = select_handoffs(read_handoffs(store), args.query, args.task)[: args.limit]
    if args.json:
        json.dump([{k: v for k, v in r.items() if k != "_path"} for r in records], sys.stdout, ensure_ascii=False, indent=2)
        print()
        return 0
    if not records:
        print("handoff нет" if not (args.query or args.task) else "совпадений нет")
        return 0
    current = session_key(session_uuid())
    place, branch, _ = work_place(store)
    here = (str(place), branch)
    groups: dict[tuple[str, str], list[dict]] = {}
    for record in records:
        groups.setdefault((handoff_place(record), handoff_branch(record)), []).append(record)
    order = sorted(groups, key=lambda g: (g != here, -float(groups[g][0].get("ts") or 0)))
    headed = len(groups) > 1 or order[0] != here
    for index, group in enumerate(order):
        if headed:
            if index:
                print()
            print(handoff_group_label(group, here))
        for record in groups[group]:
            tasks = record.get("tasks") or {}
            counts = f"закрыто {len(tasks.get('closed') or [])} · тронуто {len(tasks.get('touched') or [])}"
            marks = []
            if record.get("key") == current:
                marks.append("эта сессия")
            if record.get("kind") == "auto":
                marks.append("авто")
            if record.get("attachments"):
                marks.append(f"вложений {len(record['attachments'])}")
            if wrote_after_handoff(store, record):
                marks.append("сессия писала после handoff")
            row = f"{'  ' if headed else ''}{handoff_stamp(record)}  {str(record.get('key')):<10} {counts:<30} {handoff_title(record)[:50]}"
            if marks:
                row += "  [" + ", ".join(marks) + "]"
            print(row)
    return 0


def cmd_handoff_show(args, store: Store) -> int:
    records = read_handoffs(store)
    wanted = getattr(args, "session", None)
    place, branch, _ = work_place(store)
    found = pick_handoff(records, wanted, place, branch, args.task)
    if not found:
        if not records:
            print("handoff нет")
            return 0
        print(f"handoff не найден: {wanted or ''}{f' с задачей #{args.task}' if args.task else ''}".strip())
        return 1
    record = found[0]
    if args.json:
        data = {k: v for k, v in record.items() if k != "_path"}
        if record.get("attachments"):
            data["attachments_dir"] = str(attachments_dir(Path(record["_path"])))
        text = json.dumps(data, ensure_ascii=False, indent=2) + "\n"
    else:
        text = render_handoff(record, store, session_key(session_uuid()), handoff_where(record, place, branch))
    if args.out:
        path = Path(args.out).expanduser()
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text, encoding="utf-8")
        print(f"handoff {record.get('key')} записан: {path}")
        return 0
    sys.stdout.write(text)
    if args.json:
        return 0
    if wanted and wanted != "latest" and len(found) > 1:
        print(f"\nсовпало ещё {len(found) - 1}: cctm handoff list {shlex.quote(wanted)}")
    cutoff = time.time() - args.hours * 3600
    others = [r for r in records if r is not record and float(r.get("ts") or 0) >= cutoff]
    if others:
        print()
        print(f"параллельно писали ещё сессий: {len(others)} (за {args.hours}ч)")
        for other in others[:5]:
            where = handoff_where(other, place, branch)
            mark = f" · {where}" if where else ""
            mark += " · сессия писала после handoff" if wrote_after_handoff(store, other) else ""
            print(f"  {handoff_stamp(other)} {other.get('key')} — {handoff_title(other)[:60]}{mark}")
        print(f"  подробности: cctm handoff show <key>")
    return 0


def cmd_handoff_prune(args, store: Store) -> int:
    dropped = prune_handoffs(store, args.keep, args.days)
    print(f"удалено handoff: {dropped}")
    return 0


def cmd_session_end(args, store: Store) -> int:
    global SESSION_OVERRIDE
    payload = hook_payload() if args.from_hook else {}
    uuid = session_uuid(payload.get("session_id") or args.session)
    SESSION_OVERRIDE = uuid
    if args.from_hook:
        root = hook_root(payload.get("cwd"))
        if root is None:
            return 0
        store = Store(root)
    if not store.exists():
        return 0
    with contextlib.suppress(Exception):
        buffer = io.StringIO()
        with contextlib.redirect_stdout(buffer):
            cmd_sync(argparse.Namespace(quiet=True, from_hook=False, dry_run=False, session=None, all=False), store)
    with contextlib.suppress(Exception):
        cmd_handoff_auto(argparse.Namespace(session=uuid, quiet=True, keep=args.keep, cwd=payload.get("cwd")), store)
    return 0


# ---------------------------------------------------------------- session start

def md_section(text: str, names: tuple[str, ...]) -> str:
    wanted = {name.lower() for name in names}
    out: list[str] = []
    depth = 0
    for line in (text or "").splitlines():
        heading = re.match(r"^(#{1,6})\s+(.+?)\s*$", line)
        if heading:
            level = len(heading.group(1))
            if not depth:
                if heading.group(2).strip().lower() in wanted:
                    depth = level
                continue
            if level <= depth:
                break
        if depth:
            out.append(line)
    return "\n".join(out).strip()


def clamp_text(text: str, max_lines: int, max_chars: int) -> str:
    lines = text.splitlines()
    cut = len(lines) > max_lines
    body = "\n".join(lines[:max_lines])
    if len(body) > max_chars:
        body = body[:max_chars].rstrip()
        cut = True
    return body + (" …" if cut else "")


def self_path() -> Path:
    return Path(__file__).resolve()


def plugin_version(cctm: Path | None = None) -> str:
    manifest = (cctm or self_path()).parent.parent / ".claude-plugin" / "plugin.json"
    try:
        return str(read_json(manifest).get("version") or "")
    except (json.JSONDecodeError, OSError):
        return ""


def version_warning() -> list[str]:
    mine = self_path()
    found = shutil.which("cctm")
    if found and Path(found).resolve() == mine:
        return []
    actual = plugin_version() or "?"
    if not found:
        head = f"cctm нет в PATH (актуальная версия {actual})."
    else:
        stale = plugin_version(Path(found).resolve()) or "?"
        if stale == actual:
            return []
        head = f"cctm в PATH — версия {stale}, актуальная {actual}."
    return [f"⚠ {head}", f"Зови по пути: {mine}"]


def session_start_mode(store: Store) -> str:
    try:
        value = str(store.meta().get("session_start") or "brief").strip().lower()
    except (json.JSONDecodeError, OSError):
        return "brief"
    return value if value in SESSION_START_MODES else "brief"


def session_start_text(store: Store, mode: str, cwd: str | None = None) -> str:
    own = session_uuid()
    current = session_key(own)
    place, branch, _ = work_place(store, cwd)
    records = read_handoffs(store)
    record = own_handoff(records, place, branch)
    out: list[str] = []
    if record is not None and mode == "full":
        out.append(render_handoff(record, store, current).rstrip())
    elif record is not None:
        out.append(handoff_head(record, current))
        title = handoff_title(record)
        if title:
            out.append(f"**{title}**")
        tasks = record.get("tasks") or {}
        counts = [
            f"{label} {len(tasks.get(field) or [])}"
            for field, label in (("closed", "закрыто"), ("created", "заведено"), ("touched", "тронуто"))
            if tasks.get(field)
        ]
        if counts:
            out.append("задачи: " + " · ".join(counts))
        if record.get("attachments"):
            out.append(f"вложений: {len(record['attachments'])} — cctm handoff show {record.get('key')}")
        step = md_section(record.get("body") or "", ("следующий шаг", "next step"))
        if step:
            out.extend(["", "### Следующий шаг", clamp_text(step, SESSION_START_STEP_LINES, SESSION_START_STEP_CHARS)])
    cutoff = time.time() - HANDOFF_FRESH_HOURS * 3600
    others = [
        r for r in records
        if r is not record and r.get("key") != current and float(r.get("ts") or 0) >= cutoff
    ][:SESSION_START_OTHERS]
    if others:
        out.extend(["", "### Другие свежие handoff"] if out else ["### Другие свежие handoff"])
        for other in others:
            where = handoff_where(other, place, branch) or "здесь же"
            out.append(f"- {handoff_stamp(other)} {other.get('key')} · {where} — {handoff_title(other)[:60]}")
        out.append("показать: cctm handoff show <key>")
    try:
        neighbours = live_neighbours(store, own)
    except OSError:
        neighbours = []
    if neighbours:
        out.extend(["", "### Параллельные сессии"] if out else ["### Параллельные сессии"])
        for n in neighbours:
            if n["place"] == place:
                out.append(f"⚠ В этом дереве работает сессия {n['key']} ({fmt_age(n['age'])}): её правки в git status не твои — не откатывай.")
            else:
                out.append(f"- {n['key']} в {n['place'].name} ({fmt_age(n['age'])})")
    live = {n["key"]: f"сессия {n['key']} ({fmt_age(n['age'])})" for n in neighbours}
    ready, blocked, by_id = split_next(store, worktree_branch(cwd))
    if ready:
        out.extend(["", "### Очередь"] if out else [])
        out.extend(format_row(task, by_id, live) for task in ready[:SESSION_START_NEXT])
        rest = []
        if len(ready) > SESSION_START_NEXT:
            rest.append(f"ещё открытых: {len(ready) - SESSION_START_NEXT}")
        if blocked:
            rest.append(f"заблокировано: {len(blocked)}")
        if rest:
            out.append(" · ".join(rest))
    warn = version_warning()
    if not out and not warn:
        return ""
    head = "Контекст прошлой сессии" if record is not None else "Контекст проекта" if others or neighbours else "Очередь задач"
    lines = [f"## {head} (cc-task-manager)", ""]
    if warn:
        lines.extend(warn + [""])
    if out:
        lines.extend(out + ["", "полный контекст: /rs · задачи: /ts"])
    return "\n".join(lines).rstrip()


def cmd_session_start(args, store: Store) -> int:
    global SESSION_OVERRIDE
    payload = hook_payload() if args.from_hook else {}
    SESSION_OVERRIDE = session_uuid(payload.get("session_id") or args.session)
    if args.from_hook:
        root = hook_root(payload.get("cwd"))
        if root is None:
            return 0
        store = Store(root)
    if not store.exists():
        return 0
    source = str(payload.get("source") or args.source or "startup").strip().lower()
    if source not in SESSION_START_SOURCES:
        return 0
    mode = args.mode or session_start_mode(store)
    if mode == "off":
        return 0
    try:
        text = session_start_text(store, mode, payload.get("cwd"))
    except Exception as exc:
        if not args.quiet:
            print(f"cctm session-start: {exc}", file=sys.stderr)
        return 0
    if not text.strip():
        return 0
    if args.raw:
        print(text)
        return 0
    json.dump(
        {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": text}},
        sys.stdout,
        ensure_ascii=False,
    )
    print()
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="cctm", description="Реестр задач проекта")
    parser.add_argument("--root", help="путь к .claude/session (по умолчанию ищется от cwd вверх)")
    parser.add_argument("--no-auto-migrate", action="store_true", help="не мигрировать формат 1.x автоматически")
    parser.add_argument("--version", action="version", version=f"cctm {plugin_version() or 'unknown'} ({self_path()})")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("init", help="создать стор").set_defaults(func=cmd_init)

    p = sub.add_parser("create", help="создать задачу")
    p.add_argument("--title", required=True)
    p.add_argument("--priority", choices=PRIORITIES)
    p.add_argument("--status", default="open", choices=STATUSES)
    p.add_argument("--tags")
    p.add_argument("--blocked-by")
    p.add_argument("--order", type=int)
    p.add_argument("--md", help="файл с телом задачи или - для stdin")
    p.set_defaults(func=cmd_create)

    p = sub.add_parser("set", help="записать тело задачи")
    p.add_argument("id", type=int)
    p.add_argument("--md")
    p.add_argument("--json", dest="json")
    p.add_argument("--replace", action="store_true", help="заменить тело целиком")
    p.set_defaults(func=cmd_set)

    p = sub.add_parser("update", help="изменить метаданные")
    p.add_argument("id", type=int)
    p.add_argument("--title")
    p.add_argument("--priority", choices=PRIORITIES)
    p.add_argument("--status", choices=STATUSES)
    p.add_argument("--tags")
    p.add_argument("--add-tag")
    p.add_argument("--blocked-by")
    p.add_argument("--order", type=int)
    p.set_defaults(func=cmd_update)

    p = sub.add_parser("close", help="закрыть задачу")
    p.add_argument("id", type=int)
    p.add_argument("--md")
    p.set_defaults(func=cmd_close)

    p = sub.add_parser("reopen", help="открыть заново")
    p.add_argument("id", type=int)
    p.set_defaults(func=cmd_reopen)

    p = sub.add_parser("delete", help="удалить задачу")
    p.add_argument("id", type=int)
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_delete)

    p = sub.add_parser("list", help="список задач")
    p.add_argument("--status", default="active", choices=("active", *STATUSES, "all"))
    p.add_argument("--priority", choices=PRIORITIES)
    p.add_argument("--tag")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("next", help="что делать дальше")
    p.add_argument("--limit", type=int, default=10)
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_next)

    p = sub.add_parser("show", help="показать задачу")
    p.add_argument("id", type=int)
    p.add_argument("--md", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("grep", help="поиск по телам задач")
    p.add_argument("pattern")
    p.add_argument("--context", type=int, default=3)
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_grep)

    p = sub.add_parser("export", help="markdown-дамп реестра")
    p.add_argument("--md", action="store_true")
    p.add_argument("--out")
    p.set_defaults(func=cmd_export)

    p = sub.add_parser("doctor", help="проверка инвариантов")
    p.add_argument("--fix", action="store_true")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("merge", help="влить чужой стор (например, форк из ворктри) в этот")
    p.add_argument("source", help="путь к .claude/session источника или к каталогу проекта")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--keep-source", action="store_true", help="не переименовывать источник")
    p.set_defaults(func=cmd_merge)

    p = sub.add_parser("sync", help="синхронизация с нативным стором Claude Code")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--session", help="uuid или session-XXXXXXXX конкретной сессии")
    p.add_argument("--all", action="store_true", help="все сессии проекта, не только свежие")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--from-hook", action="store_true", help="читать payload хука из stdin")
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("handoff", help="снимок сессии для передачи следующей")
    hsub = p.add_subparsers(dest="handoff_command", required=True)

    h = hsub.add_parser("write", help="записать handoff текущей сессии")
    h.add_argument("--md", required=True, help="файл с телом handoff или - для stdin")
    h.add_argument("--title")
    h.add_argument("--closed", help="id закрытых задач через запятую")
    h.add_argument("--created", help="id заведённых задач")
    h.add_argument("--touched", help="id задач, которых касались")
    h.add_argument("--session", help="uuid сессии (по умолчанию CLAUDE_CODE_SESSION_ID)")
    h.add_argument("--attach", action="append", help="файл или каталог в handoff (можно несколько раз)")
    h.add_argument("--keep", type=int, default=HANDOFF_KEEP)
    h.add_argument("--quiet", action="store_true")
    h.set_defaults(func=cmd_handoff_write)

    h = hsub.add_parser("auto", help="технический handoff по изменениям реестра")
    h.add_argument("--session")
    h.add_argument("--keep", type=int, default=HANDOFF_KEEP)
    h.add_argument("--quiet", action="store_true")
    h.set_defaults(func=cmd_handoff_auto)

    h = hsub.add_parser("list", help="handoff всех сессий по веткам, свежие сверху")
    h.add_argument("query", nargs="?", help="фильтр: key, ветка, ворктри, дата, слово из заголовка")
    h.add_argument("--task", type=int, help="только handoff, где есть задача N")
    h.add_argument("--limit", type=int, default=10)
    h.add_argument("--json", action="store_true")
    h.set_defaults(func=cmd_handoff_list)

    h = hsub.add_parser("show", help="показать handoff сессии")
    h.add_argument("session", nargs="?", help="key, ветка, ворктри, дата, слово из заголовка или latest")
    h.add_argument("--task", type=int, help="handoff, где есть задача N")
    h.add_argument("--hours", type=int, default=HANDOFF_FRESH_HOURS)
    h.add_argument("--json", action="store_true")
    h.add_argument("--out", help="записать в файл вместо stdout")
    h.set_defaults(func=cmd_handoff_show)

    h = hsub.add_parser("latest", help="самый свежий handoff этого места")
    h.add_argument("--task", type=int, help="handoff, где есть задача N")
    h.add_argument("--hours", type=int, default=HANDOFF_FRESH_HOURS)
    h.add_argument("--json", action="store_true")
    h.add_argument("--out", help="записать в файл вместо stdout")
    h.set_defaults(func=cmd_handoff_show, session=None)

    h = hsub.add_parser("prune", help="почистить старые handoff")
    h.add_argument("--keep", type=int, default=HANDOFF_KEEP)
    h.add_argument("--days", type=int, default=0)
    h.set_defaults(func=cmd_handoff_prune)

    p = sub.add_parser("session-end", help="хук конца сессии: sync + автоматический handoff")
    p.add_argument("--session")
    p.add_argument("--keep", type=int, default=HANDOFF_KEEP)
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--from-hook", action="store_true", help="читать payload хука из stdin")
    p.set_defaults(func=cmd_session_end)

    p = sub.add_parser("session-start", help="хук старта сессии: контекст прошлой сессии")
    p.add_argument("--session")
    p.add_argument("--source", default="startup", help="startup|clear|resume|fork")
    p.add_argument("--mode", choices=SESSION_START_MODES, help="переопределить meta.session_start")
    p.add_argument("--raw", action="store_true", help="печатать текст вместо JSON для хука")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--from-hook", action="store_true", help="читать payload хука из stdin")
    p.set_defaults(func=cmd_session_start)

    p = sub.add_parser("migrate", help="перенос формата 1.x → 2.0")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--preview", type=int, default=20)
    p.add_argument("--path", help="корень проекта (по умолчанию — текущий)")
    p.set_defaults(func=cmd_migrate)

    return parser


def auto_migrate(store: Store, legacy: int) -> None:
    print(f"формат 1.x: {legacy} файлов в {store.root} — мигрирую в JSON-стор", file=sys.stderr)
    sub = argparse.Namespace(dry_run=False, preview=0, path=None)
    buffer = io.StringIO()
    with contextlib.redirect_stdout(buffer):
        cmd_migrate(sub, store)
    sys.stderr.write(buffer.getvalue().rstrip() + "\n")
    problems = argparse.Namespace(fix=True)
    check = io.StringIO()
    with contextlib.redirect_stdout(check):
        cmd_doctor(problems, store)
    sys.stderr.write(check.getvalue().rstrip() + "\n---\n")


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command == "migrate" and getattr(args, "path", None):
        store = Store(Path(args.path).resolve() / ".claude" / "session")
    else:
        store = Store(Path(args.root).resolve() if args.root else find_root())
    if args.command not in ("init", "migrate", "merge", "handoff", "session-end", "session-start") and not store.exists():
        legacy = store.legacy_count()
        if legacy and (getattr(args, "quiet", False) or getattr(args, "from_hook", False)):
            return 0
        if legacy and args.no_auto_migrate:
            print(
                f"обнаружен формат 1.x: {legacy} файлов в {store.root}\n"
                f"запусти `cctm migrate --dry-run`, затем `cctm migrate` — init создаст пустой стор поверх",
                file=sys.stderr,
            )
            return 3
        if legacy:
            auto_migrate(store, legacy)
            return args.func(args, store)
        if getattr(args, "json", False):
            json.dump([], sys.stdout, ensure_ascii=False)
            print()
            return 0
        print(f"стор не найден: {store.root} (cctm init)")
        return 0 if args.command in ("list", "next", "grep", "export", "doctor", "sync") else 1
    return args.func(args, store)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except CctmError as exc:
        print(f"cctm: {exc}", file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(130)



